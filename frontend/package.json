{
  "name": "corvus-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && VITE_DEMO=1 vite build",
    "demo:capture": "node scripts/capture-demo-fixtures.mjs",
    "demo:check": "node scripts/check-demo.mjs",
    "demo:publish": "npm run demo:capture && npm run demo:check && npm run build:demo",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/d3": "^7.4.3",
    "chart.js": "^4.5.1",
    "d3": "^7.9.0",
    "d3-force-3d": "^3.0.6",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-layout-noverlap": "^0.4.2",
    "marked": "^17.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sigma": "^3.0.2",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
