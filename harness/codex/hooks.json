{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/tylerbvogel/Projects/corvus/harness/codex/corvus_hook.py",
            "timeout": 10,
            "statusMessage": "Loading Corvus-Mind context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/tylerbvogel/Projects/corvus/harness/codex/corvus_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/tylerbvogel/Projects/corvus/harness/codex/corvus_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/tylerbvogel/Projects/corvus/harness/codex/corvus_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/tylerbvogel/Projects/corvus/harness/codex/corvus_hook.py",
            "timeout": 10,
            "statusMessage": "Closing Corvus-Mind episode"
          }
        ]
      }
    ]
  }
}
