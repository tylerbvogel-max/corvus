[Unit]
Description=Corvus Mind reconsolidation auditor (scheduled doubt, evidence-time cadence)

OnFailure=corvus-job-alert@%n.service

[Service]
Type=oneshot
# mode=auto: the evidence clock decides light/deep/skip — a quiet week
# costs nothing; the timer only offers the opportunity to run.
ExecStart=/usr/bin/curl -s --fail-with-body --max-time 900 -X POST "http://localhost:8005/auditor/run?mode=auto"
