# Scoring configuration for MEMORY tenants (corvus-mind, and any throwaway
# copy of it such as the corvus-locomo eval tenant).
#
# Single source of truth, consumed by BOTH:
#   - deploy/corvus-mind.service   (systemd EnvironmentFile=)
#   - eval/locomo/run_locomo.sh    (set -a; source)
# Keep it that way. When these values lived only inside the systemd unit, an
# eval run silently exercised the stock defaults instead of the real memory
# config — measuring a system nobody runs.
#
# Corvus stock defaults split the vote 50/50 between relevance (stimulus) and
# usage signals (modulatory). Defensible for an org knowledge graph, wrong for
# a memory: recall must return what ANSWERS the question, not what fires often.
# Popularity is a tiebreaker, not a co-equal vote.
WEIGHT_RELEVANCE=0.70
# impact stays the largest modulator: it is the only evidence-based one (earned
# trust from attribution). burst/recency are mere popularity.
WEIGHT_IMPACT=0.08
WEIGHT_RECENCY=0.06
WEIGHT_BURST=0.03
WEIGHT_PRECISION=0.03
WEIGHT_NOVELTY=0.02
# Spread activation was added to the combined score RAW. Once edge weights
# carried real dynamic range (0.12-0.80), a well-connected neighbor could gain
# ~0.6 — rivaling the entire relevance stimulus — and outranked direct semantic
# matches. Graph proximity is evidence, not an answer: it nudges, never rewrites.
WEIGHT_SPREAD_BOOST=0.20

# Horizontal-safe cache policy. Firing aggregates and mutable graph frontiers
# stay PostgreSQL-canonical across workers; only the small semantic matrix is
# replicated, guarded by a shared database revision.
CACHE_COHERENCE_MODE=database
# Belt-and-suspenders operator signal: database mode already bypasses this
# single-worker accelerator, but keep the deployment intent visible.
NEURON_INDEX_ENABLED=false
# Initial safety ceilings, explicitly deployed and observable. Each query now
# records frontier truncation and edge-limit saturation; calibrate only from
# those receipts, not from the current small graph.
SPREAD_FRONTIER_MAX_NODES=2000
SPREAD_EDGES_MAX_PER_HOP=10000

# Token-bounded neuron assembly. The 3,000-token / 150-candidate constants are
# provisional: one fixed-corpus LoCoMo conv0 sweep selected them, and the
# repeated confirmation triangle may revise or disable this policy.
MEMORY_CONTEXT_TOKEN_BUDGET=3000
MEMORY_CANDIDATE_LIMIT=150
MEMORY_MAX_DELIVERED_NEURONS=250
MEMORY_TOKEN_ESTIMATOR=utf8_bytes_div4_ceil_v1
TOKEN_BOUNDED_ASSEMBLY_ENABLED=false
