[Unit]
Description=Corvus Mind — agentic memory tenant (port 8005)

[Service]
Type=simple
Environment=TENANT_ID=corvus-mind
Environment=PORT=8005
# Memory-tenant scoring balance (relevance-dominant stimulus, modulatory usage
# signals, modulatory spread). Rationale + measurements live in the env file —
# it is the SINGLE SOURCE OF TRUTH, shared with the LoCoMo eval tenant so the
# benchmark exercises the config we actually run.
EnvironmentFile=/home/tylerbvogel/Projects/corvus/deploy/memory-tenant.env
WorkingDirectory=/home/tylerbvogel/Projects/corvus/backend
ExecStart=/home/tylerbvogel/Projects/corvus/backend/venv/bin/uvicorn app.main:app --port 8005
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target

# Install: cp deploy/corvus-mind.service ~/.config/systemd/user/ \
#   && systemctl --user daemon-reload && systemctl --user restart corvus-mind
