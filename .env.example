# =============================================================================
# Corvus-Mind Environment Configuration
# Copy to .env and fill in at least ONE LLM provider
# =============================================================================

# Core
DATABASE_URL=postgresql+asyncpg://corvus:corvus@localhost:5432/corvus_mind
TENANT_ID=corvus-mind
PORT=8005
CORS_ORIGINS=

# =============================================================================
# LLM PROVIDERS — at least ONE must be configured
# =============================================================================

# --- Option 1: Anthropic via Claude CLI (RECOMMENDED) ---
# Uses your personal Claude subscription — no API credits consumed.
# Requires: `claude auth login` on the host machine.
# In Docker: mount ~/.claude to /root/.claude (see docker-compose.yml)
CLAUDE_CLI_PATH=~/.config/nvm/versions/node/v20.20.0/bin/claude

# --- Option 2: Anthropic API (paid credits) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- Option 3: Google Gemini (free tier available) ---
# GOOGLE_API_KEY=AIza...

# --- Option 4: Groq (free tier, rate-limited) ---
# GROQ_API_KEY=gsk_...

# --- Option 5: Azure OpenAI (GovCloud/enterprise) ---
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.us/
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT_GPT4O=gpt-4o
# AZURE_OPENAI_DEPLOYMENT_GPT4O_MINI=gpt-4o-mini
# LLM_MODEL_ALIASES={"haiku":"azure-gpt4o-mini","sonnet":"azure-gpt4o"}

# Model selection (uses MODEL_REGISTRY keys)
HAIKU_MODEL=claude-haiku-4-5-20251001
TOKEN_BUDGET=8000

# =============================================================================
# MEMORY TUNING (corvus-mind defaults — override if needed)
# =============================================================================

# Provisional token-bounded assembly policy from one LoCoMo conv0 sweep.
# Count is a candidate/safety aperture; the memory-only token ceiling governs
# ordinary delivery. Keep the rollback flag false until local confirmation.
MEMORY_CONTEXT_TOKEN_BUDGET=3000
MEMORY_CANDIDATE_LIMIT=150
MEMORY_MAX_DELIVERED_NEURONS=250
MEMORY_TOKEN_ESTIMATOR=utf8_bytes_div4_ceil_v1
TOKEN_BOUNDED_ASSEMBLY_ENABLED=false

# Scoring weights (sum to 1.0 for modulatory signals)
WEIGHT_RELEVANCE=0.70
WEIGHT_IMPACT=0.08
WEIGHT_RECENCY=0.06
WEIGHT_BURST=0.03
WEIGHT_PRECISION=0.03
WEIGHT_NOVELTY=0.02
WEIGHT_SPREAD_BOOST=0.20

# Consolidation / dedup
MIND_DEDUP_REQUIRES_APPROVAL=true
CONSOLIDATION_INTERVAL_HOURS=24.0

# =============================================================================
# OPTIONAL: ACCESS CONTROL / RBAC
# =============================================================================

# Shared access key (simple mode)
# CORVUS_ACCESS_KEY=your-random-secret

# Azure AD RBAC (enterprise)
# RBAC_MODE=azure_ad
# RBAC_AZURE_TENANT_ID=...
# RBAC_ADMIN_CLAIM=corvus-admin
# RBAC_REVIEWER_CLAIM=corvus-reviewer
